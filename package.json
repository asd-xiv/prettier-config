{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@asd14/prettier-config",
  "version": "1.5.0",
  "description": "ASD14's reusable Prettier configs",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asd-xiv/prettier-config.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "main": "src/index.json",
  "scripts": {
    "----UTIL": "",
    "prepare": "git config --local core.hooksPath .githook",
    "---BUILD": "",
    "prerelease:local": "[ -f package-lock.json ] || echo 'No package-lock.json found, run `npm install` first' && exit 1",
    "release:local": "semantic-release --no-ci"
  },
  "devDependencies": {
    "@asd14/semantic-release-config": "^1.0.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "semantic-release": "^25.0.9"
  },
  "peerDependencies": {
    "prettier": "^3"
  }
}
